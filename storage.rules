rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasFluidAccess(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return request.auth != null && request.auth.uid == uid && user.schemaVersion == 2
        && request.auth.token.email_verified == true
        && request.auth.token.auth_time > user.get('sessionsRevokedBefore', 0)
        && request.time.toMillis() / 1000 - request.auth.token.auth_time < 31536000
        && user.status == 'active' && user.email == request.auth.token.email
        && (user.role == 'admin' || (user.role == 'employee' && 'fluidlab' in user.enabledMiniApps));
    }
    match /fluidlab/{wellId}/imports/{importId}/{fileId} {
      function job() { return firestore.get(/databases/(default)/documents/fluidWells/$(wellId)/imports/$(importId)).data; }
      function reservation() { return job().files[int(fileId)]; }
      allow create: if request.auth != null && hasFluidAccess(request.auth.uid) && resource == null
        && fileId.matches('^[0-4]$') && int(fileId) < job().files.size()
        && job().owner == request.auth.uid && job().wellId == wellId && job().status == 'uploading'
        && request.time < job().expiresAt
        && request.resource.size > 0 && request.resource.size <= 20971520
        && request.resource.size == reservation().size
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.importId == importId && request.resource.metadata.wellId == wellId;
      allow read, update, delete: if false;
    }
    match /fluidlab/{wellId}/pason/{uploadId}/original.zip {
      function well() { return firestore.get(/databases/(default)/documents/fluidWells/$(wellId)).data; }
      function reservation() { return firestore.get(/databases/(default)/documents/fluidWells/$(wellId)/pasonUploads/$(uploadId)).data; }
      allow get: if request.auth != null && hasFluidAccess(request.auth.uid)
        && well().status != 'deleting' && well().pason.id == uploadId;
      // Storage permits two Firestore documents per evaluation: user and reservation.
      // The server revokes reservations before deleting a well or its artifacts.
      allow create: if request.auth != null && hasFluidAccess(request.auth.uid) && resource == null
        && reservation().status == 'uploading'
        && reservation().owner == request.auth.uid && request.time < reservation().expiresAt
        && request.resource.size > 0 && request.resource.size <= 1000000000
        && request.resource.size == reservation().sizeBytes && request.resource.contentType == 'application/zip'
        && request.resource.metadata.owner == request.auth.uid && request.resource.metadata.wellId == wellId;
      allow list, update, delete: if false;
    }
    match /{object=**} { allow read, write: if false; }
  }
}
