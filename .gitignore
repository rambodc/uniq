# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Non-secret Functions parameter. RESEND_API_KEY stays in Secret Manager.
!functions/.env

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.firebase/
/.openai/
firebase-debug.log*
firestore-debug.log*
storage-debug.log*
*.tsbuildinfo
uniqenergy-firestore-export-*.json
uniqenergy-firestore-export-*.json.tmp
.lighthouse-*.json
